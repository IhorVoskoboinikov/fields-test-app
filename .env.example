# Налаштування застосунку і бази. Скопіюйте у .env і змініть за потреби:
#   cp .env.example .env
# Без .env діють ті самі значення за замовчуванням (у docker-compose.yml і app/core/settings.py).

# База даних
POSTGRES_USER=fields
POSTGRES_PASSWORD=fields
POSTGRES_DB=fields
# Адреса бази для локального запуску через uv (alembic, тести, uvicorn).
# Контейнери в docker compose завжди підключаються до db:5432 всередині мережі compose;
# POSTGRES_PORT також задає порт бази на хості.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# pgAdmin: готове підключення (docker/pgadmin/servers.json) використовує користувача fields

# Рівень логування: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
